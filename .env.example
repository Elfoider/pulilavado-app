# Solo emulador local en MigracionDevV2. Nunca colocar proyectos cloud aquí.
NEXT_PUBLIC_MIGRATION_SANDBOX=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-pulilavado-v2
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Laboratorio independiente de contratos V2 (Auth + Firestore locales).
# Requiere tests/config/firebase.contracts.json; no usar reglas permisivas del legado.
NEXT_PUBLIC_V2_CONTRACTS_SANDBOX=false
